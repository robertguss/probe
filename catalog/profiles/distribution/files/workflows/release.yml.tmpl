# Tag-triggered release (distribution profile / Section 20).
# Project: [[.Name]]
# Publication is blocked until the owner adds/reviews a LICENSE (FND-019).
# Action pins: full commit SHAs from Foundry catalog/versions.toml.

name: release

on:
  push:
    tags:
      - "v*"

permissions:
  contents: write
  id-token: write
  attestations: write

jobs:
  release:
    name: goreleaser
    runs-on: ubuntu-latest
    env:
      CGO_ENABLED: "0"
      CI: "true"
    steps:
      - name: Checkout
        # actions/checkout v5.1.0
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0
        with:
          fetch-depth: 0

      - name: Set up Go
        # actions/setup-go v6.5.0
        uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: true

      - name: License publication gate (owner-owned file)
        run: |
          set -euo pipefail
          if [ ! -f LICENSE ] && [ ! -f LICENSE.md ] && [ ! -f COPYING ]; then
            echo "Publication blocked: add and review a LICENSE before tagging a public release (FND-019)."
            echo "See docs/releasing.md."
            exit 1
          fi

      - name: Run GoReleaser
        # goreleaser/goreleaser-action v6.4.0
        uses: goreleaser/goreleaser-action@e435ccd777264be153ace6237001ef4d979d3a7a # v6.4.0
        with:
          distribution: goreleaser
          version: v2.17.1
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Attest build provenance
        # actions/attest-build-provenance v3.2.0
        uses: actions/attest-build-provenance@96278af6caaf10aea03fd8d33a09a777ca52d62f # v3.2.0
        with:
          subject-path: 'dist/*'

# Generated Core strict workflow — weekly schedule + manual dispatch (Section 16.6).
# Not a required PR gate. Owners MAY promote checks when risk justifies it.
# Project: [[.Name]]

name: strict

on:
  schedule:
    # Weekly Monday 06:00 UTC.
    - cron: "0 6 * * 1"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  linux-strict:
    name: linux-strict
    runs-on: ubuntu-latest
    env:
      CI: "true"
    steps:
      - name: Checkout
        # actions/checkout v5.1.0
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0

      - name: Set up Go
        # actions/setup-go v6.5.0 — toolchain from go.mod
        uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: true

      - name: govulncheck
        run: go tool govulncheck ./...

      - name: Race (preflighted)
        env:
          CGO_ENABLED: "1"
        run: |
          set -euo pipefail
          if ! go env CGO_ENABLED | grep -qx 1; then
            echo "race: CGO_ENABLED!=1 after export; skipping with notice"
            exit 0
          fi
          if ! go test -c -race -o /dev/null ./... >/dev/null 2>&1; then
            echo "race: compiler/preflight failed (missing C toolchain or unsupported); skipping with notice"
            exit 0
          fi
          go test -count=1 -race ./...

      - name: Bounded fuzz (when targets exist)
        run: |
          set -euo pipefail
          # Discover fuzz targets; skip cleanly when none exist (Section 16.6).
          mapfile -t pkgs < <(go list ./... 2>/dev/null || true)
          found=0
          for pkg in "${pkgs[@]+"${pkgs[@]}"}"; do
            # List fuzz tests via go test -list.
            while IFS= read -r name; do
              case "$name" in
                Fuzz*)
                  found=1
                  echo "fuzz: $pkg $name"
                  go test -count=1 "$pkg" -run='^$' -fuzz="^${name}$" -fuzztime=10s
                  ;;
              esac
            done < <(go test -count=1 -list '^Fuzz' "$pkg" 2>/dev/null || true)
          done
          if [ "$found" -eq 0 ]; then
            echo "fuzz: no Fuzz* targets found; skipping"
          fi

  macos-representative:
    name: macos-representative
    runs-on: macos-latest
    env:
      CGO_ENABLED: "0"
      CI: "true"
    steps:
      - name: Checkout
        # actions/checkout v5.1.0
        uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5.1.0

      - name: Set up Go
        # actions/setup-go v6.5.0 — toolchain from go.mod
        uses: actions/setup-go@924ae3a1cded613372ab5595356fb5720e22ba16 # v6.5.0
        with:
          go-version-file: go.mod
          cache: true

      - name: Test
        run: go test -count=1 ./...

      - name: Vet
        run: go vet ./...

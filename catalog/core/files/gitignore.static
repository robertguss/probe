# Core .gitignore (Section 16.2). Complete static file — no typed emitter.

# Binaries / build output
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Coverage
coverage.out
coverage.html
*.coverprofile

# Go workspace (local only)
go.work
go.work.sum

# Dependency copies
/vendor/

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

// Package tui owns the Bubble Tea program for [[.Binary]] (Section 18).
//
// main is the single lifecycle owner: it creates signal.NotifyContext and
// passes the cancel function here. This package constructs the program with
// tea.WithContext(appCtx) and tea.WithoutSignalHandler() only — never a second
// signal handler, and never tea.WithoutCatchPanics (framework panic recovery
// stays enabled so the terminal is restored on panic).
package tui

import (
	"context"
	"errors"
	"io"
	"os"

	tea "charm.land/bubbletea/v2"
)

// Exit codes per Section 18.3 #6 / REQ-070.
const (
	ExitOK      = 0
	ExitFailure = 1
	ExitSignal  = 130 // 128 + SIGINT
)

// Config configures one lifecycle-owned program run.
type Config struct {
	// AppCtx is the application context owned by main (signal.NotifyContext).
	AppCtx context.Context
	// Cancel cancels AppCtx; every deliberate quit path calls it before tea.Quit.
	Cancel context.CancelFunc
	// NoColor disables ANSI styling when true (--no-color).
	NoColor bool
	// Name is the project display name shown on the shell screen.
	Name string
	// Input/Output override program I/O (tests inject buffers; production nil).
	Input  io.Reader
	Output io.Writer
}

// Run constructs and executes the Bubble Tea program, mapping outcomes to the
// three exit classes: deliberate q → 0, signal/Ctrl-C → 130, failure → 1.
func Run(cfg Config) int {
	if cfg.AppCtx == nil {
		return ExitFailure
	}
	model := NewModel(ModelConfig{
		Cancel:  cfg.Cancel,
		NoColor: cfg.NoColor,
		Name:    cfg.Name,
	})

	opts := []tea.ProgramOption{
		tea.WithContext(cfg.AppCtx),
		tea.WithoutSignalHandler(),
		// DO NOT add tea.WithoutCatchPanics — framework owns terminal restore.
	}
	if cfg.Input != nil {
		opts = append(opts, tea.WithInput(cfg.Input))
	}
	if cfg.Output != nil {
		opts = append(opts, tea.WithOutput(cfg.Output))
	}
	if cfg.NoColor {
		// Force NO_COLOR so colorprofile/lipgloss downgrade to ASCII.
		env := append(append([]string(nil), os.Environ()...), "NO_COLOR=1")
		opts = append(opts, tea.WithEnvironment(env))
	}

	p := tea.NewProgram(model, opts...)
	_, runErr := p.Run()

	// Ensure cooperative future effects observe Done after return.
	if cfg.Cancel != nil {
		cfg.Cancel()
	}

	class := ClassifyRunError(runErr, model.QuitClass())
	return MapExitCode(runErr, class)
}

// QuitClass classifies how the program left the event loop (Section 18.3 #6).
type QuitClass string

const (
	QuitClassQKey     QuitClass = "q"
	QuitClassCtrlCKey QuitClass = "ctrl+c-key"
	QuitClassSignal   QuitClass = "signal"
	QuitClassRuntime  QuitClass = "runtime-failure"
	QuitClassPanic    QuitClass = "framework-recovered-panic"
)

// MapExitCode maps a run error and quit class to the three exit codes.
//
// Cancel-before-quit (Section 18.3 #4) cancels appCtx so cooperative effects
// observe Done. Because the program is also constructed with
// tea.WithContext(appCtx), that cancel races the Quit/Interrupt message and
// often surfaces as ErrProgramKilled+context.Canceled. Model-reported
// QuitClass is therefore authoritative for deliberate user paths.
func MapExitCode(err error, class QuitClass) int {
	switch class {
	case QuitClassQKey:
		return ExitOK
	case QuitClassCtrlCKey, QuitClassSignal:
		return ExitSignal
	case QuitClassPanic, QuitClassRuntime:
		return ExitFailure
	}
	if err == nil {
		return ExitOK
	}
	if errors.Is(err, tea.ErrProgramPanic) {
		return ExitFailure
	}
	if errors.Is(err, tea.ErrInterrupted) || errors.Is(err, tea.ErrProgramKilled) {
		return ExitSignal
	}
	return ExitFailure
}

// ClassifyRunError derives QuitClass from the error and model-reported class.
func ClassifyRunError(err error, modelClass QuitClass) QuitClass {
	if modelClass != "" {
		switch modelClass {
		case QuitClassQKey, QuitClassCtrlCKey:
			return modelClass
		}
	}
	if err == nil {
		if modelClass != "" {
			return modelClass
		}
		return QuitClassQKey
	}
	if errors.Is(err, tea.ErrProgramPanic) {
		return QuitClassPanic
	}
	if errors.Is(err, tea.ErrInterrupted) {
		return QuitClassCtrlCKey
	}
	if errors.Is(err, tea.ErrProgramKilled) {
		return QuitClassSignal
	}
	return QuitClassRuntime
}

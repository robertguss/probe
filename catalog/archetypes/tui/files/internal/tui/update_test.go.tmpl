package tui

import (
	"testing"

	"charm.land/bubbles/v2/key"
	tea "charm.land/bubbletea/v2"
)

func TestUpdate_QuitCancelsBeforeQuit(t *testing.T) {
	var cancelled bool
	m := NewModel(ModelConfig{
		Cancel: func() { cancelled = true },
		Name:   "[[.Name]]",
	})
	msg := tea.KeyPressMsg(tea.Key{Text: "q", Code: 'q'})
	if !key.Matches(msg, m.keys.Quit) {
		t.Fatal("fixture key must match Quit binding")
	}
	next, cmd := m.Update(msg)
	got, ok := next.(*Model)
	if !ok {
		t.Fatalf("want *Model, got %T", next)
	}
	if !cancelled {
		t.Fatal("expected cancel before tea.Quit")
	}
	if got.QuitClass() != QuitClassQKey {
		t.Fatalf("quit class: got %q want %q", got.QuitClass(), QuitClassQKey)
	}
	if cmd == nil {
		t.Fatal("expected tea.Quit cmd")
	}
}

func TestUpdate_HelpToggle(t *testing.T) {
	m := NewModel(ModelConfig{Name: "[[.Name]]"})
	if m.help.ShowAll {
		t.Fatal("help starts collapsed")
	}
	msg := tea.KeyPressMsg(tea.Key{Text: "?", Code: '?'})
	if !key.Matches(msg, m.keys.Help) {
		t.Fatal("fixture key must match Help binding")
	}
	next, _ := m.Update(msg)
	got := next.(*Model)
	if !got.help.ShowAll {
		t.Fatal("expected help expanded after ?")
	}
}

func TestUpdate_WindowSize(t *testing.T) {
	m := NewModel(ModelConfig{Name: "[[.Name]]"})
	next, _ := m.Update(tea.WindowSizeMsg{Width: 100, Height: 40})
	got := next.(*Model)
	if got.width != 100 || got.height != 40 {
		t.Fatalf("size: got %dx%d", got.width, got.height)
	}
}

func TestMapExitCode_Table(t *testing.T) {
	cases := []struct {
		name  string
		err   error
		class QuitClass
		want  int
	}{
		{"q", nil, QuitClassQKey, ExitOK},
		{"q-killed-race", tea.ErrProgramKilled, QuitClassQKey, ExitOK},
		{"ctrlc", tea.ErrInterrupted, QuitClassCtrlCKey, ExitSignal},
		{"signal", tea.ErrProgramKilled, QuitClassSignal, ExitSignal},
		{"panic", tea.ErrProgramPanic, QuitClassPanic, ExitFailure},
		{"runtime", errorsNew("boom"), QuitClassRuntime, ExitFailure},
	}
	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			if got := MapExitCode(tc.err, tc.class); got != tc.want {
				t.Fatalf("MapExitCode: got %d want %d", got, tc.want)
			}
		})
	}
}

// errorsNew avoids importing errors only for the table (keeps template small).
func errorsNew(s string) error { return &simpleErr{s} }

type simpleErr struct{ s string }

func (e *simpleErr) Error() string { return e.s }

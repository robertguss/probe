package tui

import (
	"fmt"
	"strings"

	tea "charm.land/bubbletea/v2"
)

// View is pure and side-effect free (Section 18.4 / REQ-069).
// Styling is centralized in theme.go; key help uses the Bubbles help component
// so the Bubbles dependency has immediate real use (Section 18.2).
func (m *Model) View() tea.View {
	var content string
	if m.width < MinWidth || m.height < MinHeight {
		content = tooSmallNotice(m.width, m.height)
	} else {
		content = m.renderShell()
	}
	v := tea.NewView(content)
	v.AltScreen = true
	return v
}

func (m *Model) renderShell() string {
	theme := DefaultTheme(m.noColor)
	title := theme.Title.Render(m.name)
	body := theme.Body.Render("Minimal TUI shell. Press q to quit, ? for help.")
	helpView := m.help.View(m.keys)
	var b strings.Builder
	b.WriteString(title)
	b.WriteByte('\n')
	b.WriteByte('\n')
	b.WriteString(body)
	b.WriteByte('\n')
	b.WriteByte('\n')
	b.WriteString(helpView)
	return b.String()
}

func tooSmallNotice(w, h int) string {
	return fmt.Sprintf(
		"terminal too small (%dx%d); need at least %dx%d",
		w, h, MinWidth, MinHeight,
	)
}

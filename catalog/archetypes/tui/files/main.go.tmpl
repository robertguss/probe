// Package main is the process boundary for [[.Binary]].
//
// This file is the only permitted os.Exit site and the single lifecycle owner
// for signals (Section 18.3 / REQ-070): signal.NotifyContext here, Bubble Tea
// runs with tea.WithContext + tea.WithoutSignalHandler, and no second signal
// handler exists anywhere in the tree.
package main

import (
	"context"
	"errors"
	"flag"
	"fmt"
	"io"
	"log/slog"
	"os"
	"os/signal"
	"path/filepath"
	"strings"
	"syscall"

	"[[.Module]]/internal/tui"
	"[[.Module]]/internal/version"
)

func main() {
	os.Exit(run(os.Args[1:], os.Stdout, os.Stderr))
}

// run parses startup flags, owns the application context, and maps outcomes
// to exit codes. Exactly three flags are accepted (Section 18.5): --version,
// --no-color, --debug-log <basename>.
func run(args []string, stdout, stderr io.Writer) int {
	fs := flag.NewFlagSet("[[.Binary]]", flag.ContinueOnError)
	fs.SetOutput(stderr)
	showVersion := fs.Bool("version", false, "print version and exit")
	noColor := fs.Bool("no-color", false, "disable ANSI color in the TUI")
	debugLog := fs.String("debug-log", "", "create a new debug log file (safe basename only)")
	if err := fs.Parse(args); err != nil {
		return 1
	}
	if fs.NArg() != 0 {
		fmt.Fprintf(stderr, "unexpected arguments: %s\n", strings.Join(fs.Args(), " "))
		return 1
	}

	// Capture startup working directory once for exclusive debug-log create
	// (Section 18.8). Parents are never created. Debug-log is validated before
	// --version short-circuit so invalid basenames always fail closed.
	startupWD, err := os.Getwd()
	if err != nil {
		fmt.Fprintf(stderr, "startup: working directory: %v\n", err)
		return 1
	}

	var logCloser io.Closer
	if name := strings.TrimSpace(*debugLog); name != "" {
		if err := validateDebugLogBasename(name); err != nil {
			fmt.Fprintf(stderr, "startup: --debug-log: %v\n", err)
			return 1
		}
		f, err := openDebugLogExclusive(startupWD, name)
		if err != nil {
			fmt.Fprintf(stderr, "startup: --debug-log: %v\n", err)
			return 1
		}
		logCloser = f
		defer func() { _ = f.Close() }()
		// JSON slog with redaction of known-sensitive keys (Section 18.8).
		handler := slog.NewJSONHandler(f, &slog.HandlerOptions{
			Level:       slog.LevelDebug,
			ReplaceAttr: redactSensitive,
		})
		slog.SetDefault(slog.New(handler))
	}
	_ = logCloser

	if *showVersion {
		line := version.Version
		if version.Commit != "" {
			line += " (" + version.Commit + ")"
		}
		fmt.Fprintf(stdout, "[[.Binary]] %s\n", line)
		return 0
	}

	// Single signal owner (Section 18.3 #1).
	appCtx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	code := tui.Run(tui.Config{
		AppCtx:  appCtx,
		Cancel:  stop,
		NoColor: *noColor,
		Name:    "[[.Name]]",
	})
	return code
}

// validateDebugLogBasename enforces Section 18.8 safe-basename rules:
// no path separators, no "..", not ".", not empty, not a hidden name.
func validateDebugLogBasename(name string) error {
	if name == "" || name == "." || name == ".." {
		return errors.New("name must be a non-empty safe basename (not \".\" or \"..\")")
	}
	if strings.HasPrefix(name, ".") {
		return errors.New("hidden names are not allowed")
	}
	if strings.Contains(name, string(os.PathSeparator)) || strings.Contains(name, "/") || strings.Contains(name, "\\") {
		return errors.New("path separators are not allowed; pass a basename only")
	}
	if strings.Contains(name, "..") {
		return errors.New("\"..\" is not allowed in the basename")
	}
	if filepath.Base(name) != name {
		return errors.New("must be a basename only (no directories)")
	}
	return nil
}

// openDebugLogExclusive creates a new regular file relative to startupWD with
// O_CREATE|O_EXCL|O_WRONLY and mode 0600 (Section 18.8). Existing objects of
// any type are refused; parents are never created.
func openDebugLogExclusive(startupWD, name string) (*os.File, error) {
	path := filepath.Join(startupWD, name)
	// O_EXCL refuses existing targets; mode 0600 applied at create (umask may
	// narrow further; platforms that support fchmod should re-apply after open).
	f, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0o600)
	if err != nil {
		if errors.Is(err, os.ErrExist) {
			return nil, fmt.Errorf("%s already exists; choose a new name or remove the old file manually", path)
		}
		return nil, err
	}
	// Re-apply 0600 so a permissive umask cannot leave a wider mode.
	if err := f.Chmod(0o600); err != nil {
		_ = f.Close()
		return nil, fmt.Errorf("chmod %s: %w", path, err)
	}
	info, err := f.Stat()
	if err != nil {
		_ = f.Close()
		return nil, err
	}
	if !info.Mode().IsRegular() {
		_ = f.Close()
		return nil, fmt.Errorf("%s is not a regular file", path)
	}
	return f, nil
}

// redactSensitive strips known-sensitive slog keys (Section 18.8).
func redactSensitive(_ []string, a slog.Attr) slog.Attr {
	switch strings.ToLower(a.Key) {
	case "password", "token", "secret", "authorization", "api_key", "apikey":
		return slog.String(a.Key, "[redacted]")
	default:
		return a
	}
}

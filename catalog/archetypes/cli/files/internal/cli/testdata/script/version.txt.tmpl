# Process test: version subcommand text + JSON (Section 17.5 / 17.7).

# Text mode.
exec [[.Binary]] version
stdout '[[.Binary]]'
stdout 'go:'
! stderr .

# JSON mode — stable machine-output seam.
exec [[.Binary]] version --output json
stdout '"version"'
stdout '"commit"'
stdout '"go"'
! stderr .

# Invalid --output is a usage error (exit 2).
! exec [[.Binary]] version --output yaml
stderr 'output'

# Process test: hidden completion subcommand (Section 17.2 / 17.7).

# Bash completion script is non-empty and mentions the binary.
exec [[.Binary]] completion bash
stdout '[[.Binary]]'
! stderr .

# Zsh completion also works.
exec [[.Binary]] completion zsh
stdout .
! stderr .


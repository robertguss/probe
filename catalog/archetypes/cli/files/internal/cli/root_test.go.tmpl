// TestNewRootNoArgsHelp verifies the root constructor: no subcommand prints
// help and exits 0 (Section 17.4 / REQ-066 constructor-level command tests).
func TestNewRootNoArgsHelp(t *testing.T) {
	var stdout, stderr bytes.Buffer
	code := cli.Run(context.Background(), nil, cli.Streams{
		Out: &stdout,
		Err: &stderr,
	})
	if code != cli.ExitSuccess {
		t.Fatalf("exit code: got %d want %d; stderr=%q", code, cli.ExitSuccess, stderr.String())
	}
	out := stdout.String()
	if !strings.Contains(out, "[[.Binary]]") {
		t.Fatalf("help missing binary name: %q", out)
	}
	if !strings.Contains(out, "version") {
		t.Fatalf("help missing version command: %q", out)
	}
	// completion and help are Hidden — must not appear under Available Commands.
	if strings.Contains(out, "\n  completion ") || strings.Contains(out, "\n  completion\t") {
		t.Fatalf("hidden completion leaked into help: %q", out)
	}
	if strings.Contains(out, "\n  help ") || strings.Contains(out, "\n  help\t") {
		t.Fatalf("hidden help leaked into help listing: %q", out)
	}
	if stderr.Len() != 0 {
		t.Fatalf("unexpected stderr: %q", stderr.String())
	}
}


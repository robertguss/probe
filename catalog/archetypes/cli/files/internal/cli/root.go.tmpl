// isUsageError reports whether err looks like a Cobra/pflag usage failure
// (unknown command/flag, arity, required flags) rather than a runtime error.
func isUsageError(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	for _, needle := range []string{
		"unknown command",
		"unknown flag",
		"unknown shorthand",
		"required flag",
		"invalid argument",
		"accepts at most",
		"accepts between",
		"requires at least",
		"unknown completion",
	} {
		if strings.Contains(msg, needle) {
			return true
		}
	}
	return false
}
